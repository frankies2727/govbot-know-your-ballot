{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "redirects": [
    {
      "source": "/:state(illinois|michigan|minnesota|wisconsin)",
      "destination": "/2026-11/:state",
      "permanent": true
    },
    {
      "source": "/:state(illinois|michigan|minnesota|wisconsin)/:rest*",
      "destination": "/2026-11/:state/:rest*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/2026-11/:state(illinois|michigan|minnesota|wisconsin)",
      "destination": "/2026-11/:state/index.html"
    },
    {
      "source": "/2026-11/:state(illinois|michigan|minnesota|wisconsin)/:rest*",
      "destination": "/2026-11/:state/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/2026-11/:state(illinois|michigan|minnesota|wisconsin)/ballot",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
