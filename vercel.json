{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/illinois",
      "destination": "/illinois/index.html"
    },
    {
      "source": "/illinois/(.*)",
      "destination": "/illinois/index.html"
    },
    {
      "source": "/michigan",
      "destination": "/michigan/index.html"
    },
    {
      "source": "/michigan/(.*)",
      "destination": "/michigan/index.html"
    },
    {
      "source": "/minnesota",
      "destination": "/minnesota/index.html"
    },
    {
      "source": "/minnesota/(.*)",
      "destination": "/minnesota/index.html"
    },
    {
      "source": "/wisconsin",
      "destination": "/wisconsin/index.html"
    },
    {
      "source": "/wisconsin/(.*)",
      "destination": "/wisconsin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
